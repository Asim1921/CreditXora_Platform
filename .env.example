# Deployment configuration for docker-compose.prod.yml.
# Copy to .env and fill in. Never commit the real .env.

# --- Site ------------------------------------------------------------------
# Apex domain the site is served on. Its DNS A record must point at this server
# before the stack starts, or Caddy cannot complete the ACME challenge.
DOMAIN=example.com
# Address Let's Encrypt uses for expiry/problem notices.
ACME_EMAIL=admin@example.com

# --- Database --------------------------------------------------------------
# Mongo is not published to the host; these credentials are only used inside
# the compose network.
MONGO_USER=creditxora
MONGO_PASSWORD=

# --- Security --------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Must stay stable: rotating it orphans every document already uploaded.
STORAGE_ENCRYPTION_KEY=

# --- Bootstrap admin -------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# --- Notifications ---------------------------------------------------------
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Leave SMTP_HOST blank to log emails instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Creditxora
SMTP_FROM_EMAIL=
