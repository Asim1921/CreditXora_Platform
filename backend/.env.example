# Copy to .env and adjust. Never commit the real .env.

ENVIRONMENT=development

# --- Database --------------------------------------------------------------
# Local Docker:  mongodb://localhost:27017
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=creditxora

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# Fernet key used to encrypt uploaded documents at rest. Leave blank in dev and
# one is generated into backend/var/.storage_key on first boot.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Notifications ---------------------------------------------------------
# Where admin alerts (new assessment, document uploaded, contact form) are sent.
ADMIN_NOTIFICATION_EMAIL=admin@creditxora.com

# Leave SMTP_HOST blank to log emails instead of sending them.
# Gmail: host smtp.gmail.com, port 587 (STARTTLS) or 465 (implicit TLS).
# SMTP_PASSWORD must be a 16-character Google App Password — Gmail rejects
# normal account passwords for SMTP. Requires 2-Step Verification to be on:
# https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Creditxora
# Defaults to SMTP_USER. Gmail rewrites this to the authenticated account
# unless the address is a verified "send mail as" alias.
SMTP_FROM_EMAIL=

# --- Bootstrap -------------------------------------------------------------
SEED_DEMO_DATA=true
BOOTSTRAP_ADMIN_EMAIL=admin@creditxora.com
BOOTSTRAP_ADMIN_PASSWORD=Creditxora!Admin1
